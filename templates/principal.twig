{% extends 'base.html.twig' %}
{% block content %}
    <div class="row align-items-center my-4">
        <div class="col-lg-6 position-relative">
            <img class="img-fluid rounded-lg shadow-sm mb-3 mb-lg-0" src="{{ asset('img/trabajadores.jpg') }}" alt="Equipo de trabajo" style="filter: brightness(0.8); height: 350px; object-fit: cover; width: 100%;">
            <div class="position-absolute top-0 right-0 p-3">
                <span class="badge-custom px-3 py-1">
                    <i class="fas fa-bullhorn mr-1"></i> NUEVO PORTAL
                </span>
            </div>
        </div>
        <div class="col-lg-6">
            <h3 class="font-weight-bold mb-2" style="color: #1a202c;">
                <i class="fas fa-users mr-2" style="color: #0066cc;"></i>Empleados
            </h3>

            <div class="alert-custom p-3 mb-3" style="background: linear-gradient(135deg, #f0f7ff 0%, #e6f2ff 100%); border-radius: 10px; border-left: 3px solid #0066cc;">
                <p class="mb-2 text-muted" style="font-size: 0.9rem;">
                    <strong style="color: #0066cc;">¡Estrenamos plataforma!</strong> Más moderna, rápida y segura.
                </p>

                <div class="row mb-2">
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Comprobantes de nómina</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Programación de turnos</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Certificados</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Novedades</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Capacitaciones</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Financiero</small>
                    </div>
                </div>

                <a href="https://empleado.co/" target="_blank" class="btn btn-sm text-white font-weight-bold"
                   style="background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%); border-radius: 50px; transition: all 0.3s ease; padding: 8px 20px; font-size: 0.9rem;"
                   onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 5px 15px rgba(0, 102, 204, 0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    <i class="fas fa-external-link-alt mr-1"></i> Acceder a empleado.co
                </a>
            </div>
        </div>
    </div>

    <hr class="my-4" style="border-top: 1px solid #e2e8f0;">

    <div class="row align-items-center my-4">
        <div class="col-lg-6 order-lg-2 position-relative">
            <img class="img-fluid rounded-lg shadow-sm mb-3 mb-lg-0" src="{{ asset('img/clientes.png') }}" alt="Portal de clientes" style="height: 350px; object-fit: cover; width: 100%;">
        </div>
        <div class="col-lg-6 order-lg-1">
            <h3 class="font-weight-bold mb-2" style="color: #1a202c;">
                <i class="fas fa-building mr-2" style="color: #0066cc;"></i>Clientes
            </h3>

            <div class="alert-custom p-3 mb-3" style="background: linear-gradient(135deg, #f0f7ff 0%, #e6f2ff 100%); border-radius: 10px; border-left: 3px solid #0066cc;">
                <p class="mb-2 text-muted" style="font-size: 0.9rem;">
                    <strong style="color: #0066cc;">Portal de clientes</strong> - Gestione toda la información de su cuenta.
                </p>

                <div class="row mb-2">
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Facturación electrónica</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Estado de cuenta</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Recurso humano</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Transporte</small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Programación </small>
                    </div>
                    <div class="col-6 mb-1">
                        <small><i class="fas fa-check-circle mr-1" style="color: #0066cc;"></i> Operación </small>
                    </div>
                </div>

                <a class="btn btn-sm text-white font-weight-bold" href="{{ path('login') }}"
                   style="background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%); border-radius: 50px; transition: all 0.3s ease; padding: 8px 20px; font-size: 0.9rem;"
                   onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 5px 15px rgba(0, 102, 204, 0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    Ingresar <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="text-white my-4 py-3 text-center" style="background: linear-gradient(135deg, #004d99 0%, #0066cc 50%, #0080ff 100%); border-radius: 15px;">
        <p class="m-0" style="font-size: 1.1rem;">
            <i class="fas fa-rocket mr-2"></i> Servicios + Productos + Software + Contenidos + Fácil
        </p>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .badge-custom {
            background: linear-gradient(135deg, #0066cc 0%, #0080ff 100%);
            color: white;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .alert-custom {
            transition: all 0.3s ease;
        }

        .alert-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 102, 204, 0.15);
        }

        .rounded-lg {
            border-radius: 12px !important;
        }

        .shadow-sm {
            box-shadow: 0 5px 15px rgba(0,0,0,0.08) !important;
        }

        small {
            font-size: 0.8rem;
            line-height: 1.6;
        }

        @media (max-width: 992px) {
            .order-lg-1 { order: 1; }
            .order-lg-2 { order: 2; }
        }
    </style>
{% endblock %}